---
import Cifernik from './Cifernik.astro';
import { STAVY, kratkeUdaje, cena } from '../lib/hodinky.js';

const { hodinky } = Astro.props;
const d = hodinky.data;
const z = hodinky.znacka.data;
---
<a
  href={`/hodinky/${hodinky.id}/`}
  class="karta-hodiniek karta"
  data-stav={d.stav}
  data-styl={d.styl}
>
  <div class="foto">
    {d.fotky.length > 0
      ? <img src={d.fotky[0]} alt="" loading="lazy" referrerpolicy="no-referrer" />
      : <Cifernik farba={d.farba} luneta={d.luneta} chrono={d.styl === 'Chronograf'} />}
    <span class={`stav stav-${d.stav}`}>{STAVY[d.stav]}</span>
  </div>
  <div class="telo">
    <div class="znacka"><span>{z.nazov}</span><span>{z.krajina}</span></div>
    <h3>{d.model}</h3>
    <div class="mono udaje">{kratkeUdaje(d)}</div>
    <div class="paticka">
      <strong>{cena(d.cena) ? 'cca ' + cena(d.cena) : ''}</strong>
      <span>{d.styl}</span>
    </div>
  </div>
</a>

<style>
  .karta-hodiniek {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: var(--atrament);
  }
  .karta-hodiniek:hover { border-color: var(--atrament); color: var(--atrament); }
  .foto {
    position: relative;
    height: 260px;
    background: #ECECE8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .foto img { width: 100%; height: 100%; object-fit: contain; background: var(--biela); }
  .foto .stav { position: absolute; top: 14px; left: 14px; }
  .telo {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }
  .znacka {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grafit);
  }
  h3 { font-size: 21px; line-height: 1.2; }
  .udaje { font-size: 14px; color: var(--text-2); }
  .paticka {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--linka);
    font-size: 15px;
  }
  .paticka span { color: var(--grafit); }
</style>
