---
const { velkost = 34, farba = 'var(--atrament)', akcent = 'var(--sekundovka)' } = Astro.props;
---
<svg viewBox="0 0 48 48" width={velkost} height={velkost} aria-hidden="true">
  <circle cx="24" cy="24" r="21" fill="none" stroke={farba} stroke-width="3" />
  <line x1="24" y1="7" x2="24" y2="12" stroke={farba} stroke-width="3" />
  <line x1="41" y1="24" x2="36" y2="24" stroke={farba} stroke-width="3" />
  <line x1="24" y1="41" x2="24" y2="36" stroke={farba} stroke-width="3" />
  <line x1="7" y1="24" x2="12" y2="24" stroke={farba} stroke-width="3" />
  <line x1="24" y1="24" x2="15.5" y2="19" stroke={farba} stroke-width="3" stroke-linecap="round" />
  <line x1="24" y1="24" x2="34" y2="15" stroke={farba} stroke-width="2.4" stroke-linecap="round" />
  <line x1="24" y1="24" x2="27" y2="35" stroke={akcent} stroke-width="1.4" stroke-linecap="round" />
  <circle cx="24" cy="24" r="2.6" fill={akcent} />
</svg>
