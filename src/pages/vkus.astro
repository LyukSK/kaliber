---
import Zaklad from '../layouts/Zaklad.astro';
import Cifernik from '../components/Cifernik.astro';
import { nacitajHodinky, cislo, cena, hodiniek } from '../lib/hodinky.js';
import vkus from '../data/vkus.json';

const vsetky = await nacitajHodinky();
// Chcem a Mám vážia dvakrát viac ako inšpirácia a krásne, ale drahé.
const vaha = (h) => (h.data.stav === 'inspiracia' || h.data.stav === 'drahe' ? 1 : 2);
const MIN = 10;

function skupina(titulok, hodnota) {
  const sucty = new Map();
  for (const h of vsetky) {
    const k = hodnota(h);
    if (k == null) continue;
    sucty.set(k, (sucty.get(k) ?? 0) + vaha(h));
  }
  const riadky = [...sucty.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);
  const max = Math.max(1, ...riadky.map((r) => r[1]));
  return { titulok, riadky: riadky.map(([k, n], i) => ({ k, n, pct: Math.round((n / max) * 100), prvy: i === 0 })) };
}

const skupiny = [
  skupina('Veľkosť puzdra', (h) => h.data.priemer && cislo(h.data.priemer) + 'mm'),
  skupina('Štýl', (h) => h.data.styl),
  skupina('Strojček', (h) => h.data.pohon),
  skupina('Pôvod značky', (h) => h.znacka.data.krajina),
].filter((s) => s.riadky.length > 0);

// Hodinky v stave Krásne, ale drahé sú mimo rozpočtu, preto cenové rozpätie neskresľujú.
const ceny = vsetky.filter((h) => h.data.stav !== 'drahe').map((h) => h.data.cena).filter(Boolean);
const analyza = vkus.analyza ? new Date(vkus.analyza).toLocaleDateString('sk-SK') : null;
---
<Zaklad titulok="Môj vkus" aktivne="vkus">
  <div class="hlavicka-stranky">
    {analyza && <div class="stitok">Posledná analýza · {analyza}</div>}
    <h1 class="nadpis-stranky">Môj vkus</h1>
    <p class="uvod">
      Profil sa skladá zo všetkých hodiniek v zbierke. Hodinky v stave Chcem a Mám vážia viac ako inšpirácia a Krásne, ale drahé, ktoré sa navyše nepočítajú do cenového rozpätia.
      Teraz vychádza z {vsetky.length === 1 ? 'jedných hodiniek' : `${vsetky.length} kúskov`}{vsetky.length < MIN && `, spoľahlivý bude zhruba od ${MIN}`}.
    </p>
  </div>

  {vkus.zhrnutie && (
    <div class="tmava zhrnutie">
      <div class="stitok">Zhrnutie</div>
      <p class="serif">{vkus.zhrnutie}</p>
    </div>
  )}

  <div class="statistiky">
    {skupiny.map((s) => (
      <section class="karta">
        <h2 class="stitok">{s.titulok}</h2>
        {s.riadky.map((r) => (
          <div class="pruh">
            <div class="popis"><span>{r.k}</span></div>
            <div class="stopa"><div class:list={['vypln', { prvy: r.prvy }]} style={`width: ${r.pct}%`}></div></div>
          </div>
        ))}
      </section>
    ))}
    {ceny.length > 0 && (
      <section class="karta">
        <h2 class="stitok">Cena</h2>
        <p class="cena-rozpatie">{cena(Math.min(...ceny))} až {cena(Math.max(...ceny))}</p>
        <p class="poznamka">podľa {hodiniek(ceny.length)} s uvedenou cenou</p>
      </section>
    )}
  </div>

  <section class="navrhy">
    <div class="hlavicka-stranky">
      <h2 class="nadpis-sekcie">Návrhy na tento týždeň</h2>
      <p class="uvod">Konkrétne hodinky, hlavne od európskych značiek, ktoré v zbierke ešte nie sú a podľa profilu by ma mohli zaujať. Obnovujú sa každý pondelok.</p>
    </div>
    {vkus.navrhy.length > 0
      ? (
        <div class="mriezka">
          {vkus.navrhy.map((n) => (
            <article class="karta navrh">
              {n.model && (
                <div class="foto">
                  {n.obrazok
                    ? <img src={n.obrazok} alt="" loading="lazy" referrerpolicy="no-referrer" />
                    : <Cifernik velkost="160" />}
                </div>
              )}
              <div class="telo">
                <div class="znacka"><span>{n.znacka}</span><span>{n.krajina}</span></div>
                <h3>{n.model ?? n.znacka}</h3>
                {n.model && (
                  <div class="mono udaje">{[n.priemer && `${cislo(n.priemer)}mm`, n.pohon, n.styl].filter(Boolean).join(' · ')}</div>
                )}
                <p class="serif">{n.preco}</p>
                <div class="paticka">
                  {n.cena && <strong>cca {cena(n.cena)}</strong>}
                  {(n.odkaz || n.web) && <a href={n.odkaz ?? n.web} rel="noopener" class="tlacidlo obrys">Pozrieť v obchode</a>}
                </div>
                {n.model && n.odkaz && (
                  <button type="button" class="tlacidlo do-wishlistu len-majitel" data-pokyn={`Pridaj z návrhov do zoznamu prianí: ${n.znacka} ${n.model} ${n.odkaz}`}>
                    Pridať do wishlistu
                  </button>
                )}
              </div>
            </article>
          ))}
        </div>
      )
      : <p class="prazdne karta">Prvé návrhy pribudnú pri najbližšom týždennom spracovaní.</p>}
  </section>
  <p class="hlaska" id="hlaska" role="status" hidden>Pokyn je skopírovaný. Vlož ho do Claude Code a hodinky pribudnú v zozname prianí.</p>
</Zaklad>

<script>
  const hlaska = document.getElementById('hlaska');
  let casovac;
  document.querySelectorAll('.do-wishlistu').forEach((b) => {
    b.addEventListener('click', async () => {
      const pokyn = b.dataset.pokyn;
      try {
        await navigator.clipboard.writeText(pokyn);
        hlaska.textContent = 'Pokyn je skopírovaný. Vlož ho do Claude Code a hodinky pribudnú v zozname prianí.';
      } catch {
        hlaska.textContent = `Skopíruj a vlož do Claude Code: ${pokyn}`;
      }
      hlaska.hidden = false;
      clearTimeout(casovac);
      casovac = setTimeout(() => (hlaska.hidden = true), 6000);
    });
  });
</script>

<style>
  .do-wishlistu { width: 100%; }
  .hlaska {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    margin: 0 auto;
    max-width: 560px;
    padding: 16px 20px;
    background: var(--atrament);
    color: var(--cifernik);
    border-radius: 4px;
    font-size: 15px;
    line-height: 1.45;
    z-index: 10;
  }
  .zhrnutie { padding: clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: 16px; }
  .zhrnutie p { margin: 0; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.4; max-width: 980px; }
  .statistiky { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .statistiky .karta { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .pruh { display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .stopa { height: 8px; background: #ECECE8; border-radius: 4px; overflow: hidden; }
  .vypln { height: 8px; background: var(--atrament); border-radius: 4px; }
  .vypln.prvy { background: var(--sekundovka); }
  .cena-rozpatie { margin: 0; font-size: 26px; font-weight: 700; }
  .poznamka { margin: 0; font-size: 14px; color: var(--grafit); }
  .navrhy { display: flex; flex-direction: column; gap: 24px; border-top: 2px solid var(--atrament); padding-top: 40px; }
  .nadpis-sekcie { font-size: 40px; letter-spacing: -0.01em; }
  .navrh { display: flex; flex-direction: column; overflow: hidden; }
  .navrh .foto { height: 240px; background: #ECECE8; display: flex; align-items: center; justify-content: center; }
  .navrh .foto img { width: 100%; height: 100%; object-fit: contain; background: var(--biela); }
  .navrh .telo { padding: 20px; display: flex; flex-direction: column; gap: 10px; flex-grow: 1; }
  .navrh .znacka { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--grafit); }
  .navrh h3 { font-size: 22px; line-height: 1.2; }
  .navrh .udaje { font-size: 14px; color: var(--text-2); }
  .navrh p { margin: 0; font-size: 17px; line-height: 1.5; flex-grow: 1; }
  .navrh .paticka { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid var(--linka); }
</style>
